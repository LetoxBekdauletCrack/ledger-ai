# LedgerAI Production Environment Configuration (.env.prod.example)
# Rename to .env.prod and inject secure secrets in deployment pipeline

NODE_ENV=production
PORT=3000
DATABASE_URL="postgresql://ledger_prod:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/ledger_ai_prod?schema=public&sslmode=prefer"
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32_CHARACTERS_MINIMUM"
NEXTAUTH_URL="https://app.ledgerai.com"
ENABLE_AUTO_SEED=false

# Observability (OpenTelemetry & Prometheus)
OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4318"
OTEL_SERVICE_NAME="ledger-ai-prod"
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL=warn
